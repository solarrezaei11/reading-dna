# Required for Reading DNA, recommendations, predictions, and cluster naming.
# Get a key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Optional extra free-tier providers for the recommendation battle. Any model
# whose key is set joins the N-way battle automatically; leave a key blank to
# exclude that provider. Both are OpenAI-compatible (no extra SDK needed).
# Groq: https://console.groq.com/keys   OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Which model each provider contributes to the battle. Free-tier model
# availability rotates over time, so these are overridable without a code
# change. Defaults are current, widely-available free-tier chat models.
GROQ_BATTLE_MODEL=llama-3.3-70b-versatile
OPENROUTER_BATTLE_MODEL=google/gemma-4-26b-a4b-it:free

# Upper bound on generated tokens per battle completion. Must be generous
# enough for reasoning models to finish, yet low enough to stay under free
# tiers' per-minute token limits (e.g. Groq free ~12k TPM). Overridable.
BATTLE_MAX_COMPLETION_TOKENS=8000

# Public frontend configuration. These values are embedded in browser output.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the FastAPI backend.
CORS_ORIGINS=http://localhost:3000

# Optional deployment-wide backend gate. Keep this server-side; never expose
# it through a NEXT_PUBLIC_ variable. Direct browser deployments should use an
# authenticated ingress or trusted server-side proxy if this is enabled.
BACKEND_ACCESS_TOKEN=

# Disabled by default. When enabled, predictions are appended to
# backend/predictions.jsonl and must be handled as private reading-history data.
ENABLE_PREDICTION_LOG=false

# Request and collection limits.
MAX_JSON_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=15728640
MAX_COLLECTION_SIZE=5000
MAX_REVIEW_EXCERPT_CHARS=400

# Goodreads RSS pagination.
GOODREADS_RSS_MAX_PAGES=25
GOODREADS_RSS_PAGE_DELAY_SECONDS=0.4

# Libby / OverDrive lookup and cache controls.
LIBBY_CATALOG_MAX_PAGES=150
LIBBY_CATALOG_TTL_SECONDS=21600
LIBBY_CATALOG_FETCH_CONCURRENCY=10
LIBBY_MEDIA_CONCURRENCY=8

# Paid LLM and CPU-bound analysis controls.
MAX_LLM_CONCURRENCY=4
LLM_ATTEMPT_TIMEOUT_SECONDS=45
CPU_ANALYSIS_CONCURRENCY=2

# Per-process, per-endpoint rate limiting.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=300
# Keep at 0 unless the backend accepts traffic only through this many
# trusted proxies, each of which appends or replaces X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# In-memory embedding cache.
EMBEDDING_CACHE_MAX_ENTRIES=1000

# Open Library verification of model-supplied recommendation ISBNs.
ISBN_VERIFY_CONCURRENCY=5
ISBN_VERIFY_TIMEOUT_SECONDS=8
